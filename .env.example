# Required in production
PORT=3000
JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRES=30d

# Railway Postgres – auto-set when you add the plugin, or paste connection string
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Set to false only for local Postgres without SSL
# DATABASE_SSL=false

# Railway Redis – auto-set when you add Redis plugin
REDIS_URL=redis://default:pass@host:6379

# Optional
# PG_POOL_MAX=20
# NODE_ENV=production
